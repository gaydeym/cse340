<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

        <%- messages() %>
            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <h4>Confirm Deletion - The delete is permanent.</h4>
                    <form id="deleteReviewForm" class="inv-form" action="/review/delete-review" method="post">
                        <label for="review_date">Review Date</label>
                        <input type="text" id="review_date" name="review_date" value="<%= locals.review_date %>" readonly />
                        <label for="review_text">Review Comment</label>
                        <textarea id="review_text" name="review_text" readonly><%= locals.review_text %></textarea>
                        <button type="submit" class="delete">Delete Review</button>
                        <input type="hidden" name="review_id" <% if (locals.review_id) { %> value="<%= locals.review_id%>" <% } %>>
                    </form>
