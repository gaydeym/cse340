<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

        <%- messages() %>
            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <form class="inv-form" action="/inv/add-classification" method="post">
                        <p class="fine-print">Name must be alphabetic characters only!</p>
                        <label for="classification_name">Classification Name<input type="text" id="classification_name" name="classification_name" required pattern="[A-Za-z]+" value="<%= locals.classification_name %>" title="Name must contain alphabetic characters only!"></label>
                        <input type="submit" value="Add Classification">
                    </form>