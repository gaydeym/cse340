<!-- Content Heading -->
<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

        <%- messages() %>
            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <%- listing %>

                        <h2>Customer Reviews</h2>

                        <%- customerReviews %>
                            <% if (locals.loggedin) { %>
                                <% const firstInitial=locals.accountData.account_firstname ?
                                    locals.accountData.account_firstname.charAt(0).toUpperCase() : '' ; const
                                    lastName=locals.accountData.account_lastname ? locals.accountData.account_lastname
                                    : '' ; const screenName=`${firstInitial}${lastName}`; %>

                                    <h3>Write your own review</h3>
                                    <form id="reviewForm" class="form-container" action="/review/add-review"
                                        method="post">

                                        <label for="screen_name">Screen Name</label>
                                        <input type="text" id="screenName" name="screenName" readonly
                                            value="<%- screenName %>" />

                                        <label for="review_text">Review</label>
                                        <textarea id="review_text" name="review_text" 
                                            placeholder="Add review here..." title="Please enter your review."
                                            required></textarea>

                                        <button type="submit">Submit Review</button>

                                        <input type="hidden" name="inv_id" <% if (locals.inv_id) { %> value="<%=
                                            locals.inv_id %>" <% } %>>
                                                <input type="hidden" name="account_id" <% if (locals.account_id) { %>
                                                value="<%= locals.account_id %>"
                                                    <% } %>>
                                    </form>
                                    </div>
                                    </div>
                                    <p>Welcome <%- screenName %> you are logged in.</p>
                                    <% } else { %>
                                        <p>You must be <a href="/account/login" title="Click to log in">logged in</a> to
                                            write a review.</p>
                                        <% } %>

                                            </section>