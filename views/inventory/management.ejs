<% if (title) { %>
    <h1>
        <%= title %>
    </h1>
    <% } else { res.redirect('/') } %>

        <%- messages() %>
            <% if (errors) { %>
                <ul class="notice">
                    <% errors.array().forEach(error=> { %>
                        <li>
                            <%= error.msg %>
                        </li>
                        <% }) %>
                </ul>
                <% } %>

                    <div class="management-container">
                        <a href="/inv/add-classification" class="submit-button">Add New Classification</a>
                        <a href="/inv/add-inventory" class="submit-button">Add New Inventory</a>
                    </div>

                    <section class="management-container">
                        <h3>Manage Inventory</h3>
                        <p>Select a classification from the list to see the items belonging to the classification.</p>
                        <div class="dropdown">
                            <label for="classification_id">Classification List</label>
                            <%- classificationSelect %>
                        </div>
                        <table id="inventoryDisplay"></table>
                        <noscript>JavaScript must be enabled to use this page.</noscript>
                    </section>
                    
                    <script src="/js/inventory.js"></script>